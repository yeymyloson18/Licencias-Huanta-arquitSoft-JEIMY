{
  "info": {
    "name": "Licencias Huanta – recorrido de humo (008)",
    "description": "Recorrido de humo del Sprint 2: endpoints públicos con éxito, protegidos con 401 sin token y 403 con un rol que no corresponde. Los tokens NO están en el repositorio: el flujo postman.yml los genera en el ejecutor con usuarios de demostración.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "1. Públicos",
      "item": [
        {
          "name": "Salud del sistema",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/salud",
              "host": ["{{baseUrl}}"],
              "path": ["salud"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Salud del sistema: responde 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('responde en menos de 2 s (EQ-01)', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "pm.test('base de datos OK', function () {",
                  "  pm.expect(pm.response.json().baseDeDatos).to.eql('OK');",
                  "});"
                ]
              }
            }
          ]
        },
        {
          "name": "Catálogo de licencias",
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/catalogo/recetas?tipo=LICENCIA",
              "host": ["{{baseUrl}}"],
              "path": ["catalogo", "recetas"],
              "query": [
                {
                  "key": "tipo",
                  "value": "LICENCIA"
                }
              ]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('Catálogo de licencias: responde 200', function () {",
                  "  pm.response.to.have.status(200);",
                  "});",
                  "pm.test('responde en menos de 2 s (EQ-01)', function () {",
                  "  pm.expect(pm.response.responseTime).to.be.below(2000);",
                  "});",
                  "pm.test('lista con al menos una licencia y caché pública de 60 s', function () {",
                  "  pm.expect(pm.response.json().length).to.be.above(0);",
                  "  pm.expect(pm.response.headers.get('Cache-Control')).to.eql('public, max-age=60');",
                  "});"
                ]
              }
            }
          ]
        },
