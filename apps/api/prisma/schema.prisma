generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
  schemas  = ["comun", "seguridad", "catalogo", "tramites", "pagos", "inspecciones", "licencias", "plazos", "notificaciones"]
}

model pregunta_asistente {
  codigo   String @id @db.VarChar(30)
  orden    Int    @unique @db.SmallInt
  texto    String
  opciones Json

  @@schema("catalogo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model Receta {
  codigo          String            @id @db.VarChar(10)
  nombre          String            @db.VarChar(150)
  tipo            String            @db.VarChar(20)
  codigo_tupa     String            @unique @db.VarChar(15)
  pagina_tupa     Int               @db.SmallInt
  ruta            String?           @db.Char(1)
  nivel_riesgo    String?           @db.VarChar(10)
  es_cesionario   Boolean           @default(false)
  es_corporativa  Boolean           @default(false)
  tasa            Decimal           @db.Decimal(10, 2)
  plazo_dias      Int?              @db.SmallInt
  tipo_plazo      String            @default("HABILES") @db.VarChar(12)
  calificacion    String            @db.VarChar(40)
  orden_itse      String?           @db.VarChar(15)
  plazo_itse_dias Int?              @db.SmallInt
  vigencia_meses  Int?              @db.SmallInt
  activa          Boolean           @default(true)
  actualizada_por String?           @db.Uuid
  actualizada_en  DateTime          @default(now()) @db.Timestamptz(6)
  cambio_receta   cambio_receta[]
  regla_asistente regla_asistente[]
  requisito       requisito[]

  @@map("receta")
  @@schema("catalogo")
}

model regla_asistente {
  id            BigInt @id @default(autoincrement())
  prioridad     Int    @unique @db.SmallInt
  condiciones   Json
  codigo_receta String @db.VarChar(10)
  receta        Receta @relation(fields: [codigo_receta], references: [codigo], onDelete: NoAction, onUpdate: NoAction)

  @@schema("catalogo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model requisito {
  id             BigInt  @id @default(autoincrement())
  codigo_receta  String  @db.VarChar(10)
  orden          Int     @db.SmallInt
  descripcion    String
  obligatorio    Boolean @default(true)
  condicion      String  @default("SIEMPRE") @db.VarChar(30)
  acepta_archivo Boolean @default(true)
  receta         Receta  @relation(fields: [codigo_receta], references: [codigo], onDelete: Cascade, onUpdate: NoAction)

  @@unique([codigo_receta, orden])
  @@schema("catalogo")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model ejecucion_tarea {
  nombre_tarea String    @db.VarChar(60)
  fecha        DateTime  @db.Date
  instancia    String    @db.VarChar(100)
  iniciada_en  DateTime  @default(now()) @db.Timestamptz(6)
  terminada_en DateTime? @db.Timestamptz(6)
  resultado    String?   @db.VarChar(20)
  detalle      String?

  @@id([nombre_tarea, fecha])
  @@schema("comun")
}

model evento_pendiente {
  id            BigInt    @id @default(autoincrement())
  tipo          String    @db.VarChar(60)
