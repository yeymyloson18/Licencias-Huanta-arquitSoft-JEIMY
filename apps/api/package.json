{
  "name": "@licencias/api",
  "version": "1.0.0",
  "private": true,
  "description": "Backend NestJS del Sistema de Licencias de Funcionamiento",
  "scripts": {
    "build": "prisma generate && nest build -p tsconfig.build.json",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "start": "node dist/main.js",
    "test": "jest",
    "test:unit": "jest --selectProjects unit",
    "test:integracion": "jest --selectProjects integracion",
    "cobertura": "jest --selectProjects unit --coverage"
  },
  "dependencies": {
    "@licencias/contracts": "*",
    "@nestjs/common": "^11.2.10",
    "@nestjs/core": "^11.2.10",
    "@nestjs/platform-express": "^11.2.10",
    "@prisma/client": "^6.19.3",
    "ioredis": "^5.11.1",
    "prisma": "^6.19.3",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@nestjs/cli": "^11.0.24",
    "@nestjs/testing": "^11.2.10",
    "@redocly/openapi-core": "^1.34.24",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.19.2",
    "@types/supertest": "^7.2.1",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "jest": "^30.5.2",
    "supertest": "^7.3.2",
    "ts-jest": "^29.4.15",
    "yaml": "^2.9.1"
  }
}
