# Valores ficticios solo para desarrollo local. No usar en producción.
# Docker Compose funciona sin este archivo (usa estos mismos valores por defecto).
# Para cambiar un puerto ocupado: copiar este archivo a infra/.env y editarlo.

PUERTO_API=3000
PUERTO_WEB=8080
PUERTO_POSTGRES=5432
PUERTO_REDIS=6379

POSTGRES_USER=licencias
POSTGRES_PASSWORD=cambiar_en_produccion_solo_desarrollo
POSTGRES_DB=licencias

# Usadas por la API y las pruebas ejecutadas fuera de Docker.
DATABASE_URL=postgresql://licencias:cambiar_en_produccion_solo_desarrollo@localhost:5432/licencias
REDIS_URL=redis://localhost:6379

# Máximo 240: Redis 240 s + navegador 60 s = 5 min (FR-024 de la 003)
CATALOGO_CACHE_TTL_SEGUNDOS=240
SALUD_TIMEOUT_MS=2000
VERSION_SERVICIO=1.0.0

# Seguridad y usuarios (funcionalidad 002, research.md §R-16). Valores FICTICIOS solo para desarrollo:
# en producción la API se niega a arrancar si alguna clave es igual a estos valores.
NODE_ENV=development
# Secreto de firma del token de acceso (al menos 32 bytes).
JWT_SECRETO=desarrollo-jwt-solo-no-usar-en-produccion
# Clave AES-256-GCM para cifrar correo y celular: base64 de exactamente 32 bytes.
CLAVE_CIFRADO_DATOS=ZGVzYXJyb2xsby1jaWZyYWRvLW5vLXVzYXItcHJvZCE=
# Clave HMAC-SHA256 para buscar por correo/celular y para la huella del código OTP: base64 de 32 bytes o más.
CLAVE_HMAC_DATOS=ZGVzYXJyb2xsby1obWFjLXNvbG8tbm8tdXNhci1lbi1wcm9kdWNjaW9u
# Envío del código OTP: "simulado" (desarrollo y pruebas; prohibido en producción) o "sms".
ENVIO_OTP=simulado
# Proxies delante de la API: 1 = solo el nginx del portal; 2 = balanceador + nginx.
TRUST_PROXY_SALTOS=1
# Carpeta del almacén de documentos (004): ruta absoluta, fuera de la carpeta pública del portal y
# compartida por todas las instancias de la API (research §R-08). En Docker Compose es un volumen.
ALMACEN_ARCHIVOS_RUTA=/var/lib/licencias/archivos

# Cada cuántos milisegundos el despachador revisa la cola de eventos entre módulos (005); 0 lo apaga.
DESPACHADOR_INTERVALO_MS=2000
