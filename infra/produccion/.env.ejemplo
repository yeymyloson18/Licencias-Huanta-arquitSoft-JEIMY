# Variables de producción (007). Este archivo solo tiene los NOMBRES: copie a `.env` en el servidor y
# complete cada valor ahí (nunca en el repositorio). La guía docs/07-despliegue/guia-vps.md explica
# cómo generar cada secreto en el servidor con `openssl rand`.

# Dirección pública. Sin dominio propio: la IP del servidor con guiones + .sslip.io
# (por ejemplo 164-90-143-165.sslip.io). Con dominio: el dominio, y seguir dominio-cloudflare.md.
DOMINIO=

# Imágenes publicadas por el flujo cd.yml en GitHub Container Registry y la versión desplegada
# (desplegar.sh cambia VERSION en cada despliegue).
IMAGEN_API=
IMAGEN_PORTAL=
VERSION=

# Base de datos (la clave: openssl rand -base64 32 | tr -d '/+=').
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_DB=

# Secretos de la aplicación (002): JWT con openssl rand -base64 48; las claves de datos con
# openssl rand -base64 32 (cifrado AES-256-GCM y HMAC). Si se pierden, los datos cifrados no se leen.
JWT_SECRETO=
CLAVE_CIFRADO_DATOS=
CLAVE_HMAC_DATOS=

# Opcionales (tienen un valor por defecto en docker-compose.yml).
# ENVIO_OTP=simulado
# TRUST_PROXY_SALTOS=1          (2 cuando haya Cloudflare delante)
# RELOJ_PLAZOS_INTERVALO_MS=3600000
# AVISOS_INTERVALO_MS=5000
# PGBOUNCER_POOL=20
# PUERTO_HTTP=80
# PUERTO_HTTPS=443
